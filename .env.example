# Copy this file to `.env` at the project root and adjust as needed.
# OAuth secrets (credentials.json / token.json) are NOT stored here.

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# When true, grading runs without writing anything back to Classroom
DRY_RUN=false

# Dashboard (home view): run the automated DRY_RUN evaluation automatically
# whenever the pending-submissions data is refreshed, instead of requiring the
# "Run Automated Dry-Run" button. Defaults to false - a dry-run still spends
# Groq tokens, so starting one stays a deliberate choice. Either way the
# dry-run only reads from Google Classroom: it never pushes grades, comments
# or returns. See src/dashboard.py.
DASHBOARD_AUTO_DRY_RUN=false

# Groq (OpenAI-compatible) API key - https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used for evaluations (optional; defaults to qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Groq's OpenAI-compatible endpoint (optional; rarely needs changing)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Extra Groq keys, comma-separated (optional). Keys rotate when one is rate
# limited. Note that Groq's tokens-per-DAY cap is shared across an
# organisation, so keys from the same org all die together - extra keys only
# help for the per-minute limits.
GROQ_API_KEYS=

# --- Fallback provider (used only when every Groq key is exhausted) ---------
# Groq's free tier has a daily token cap (TPD). Once it is hit the batch would
# otherwise stall on 429s that cannot resolve until midnight, so the router
# switches to this provider instead and says so in the UI.
#
# Pick a provider by name and you only need the API key - the base URL and a
# sensible default model are filled in for you:
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# Optional overrides for the named provider (LLM_FALLBACK_MODEL wins over the
# preset's default, e.g. gemini-2.0-flash for 'gemini'):
LLM_FALLBACK_MODEL=
#
# To use any other OpenAI-compatible endpoint, leave LLM_FALLBACK_PROVIDER
# empty and set both of these explicitly:
LLM_FALLBACK_BASE_URL=
#
# Known providers: gemini, openrouter.
# Leaving these empty simply disables the fallback: the run stops with a clear
# "daily quota exhausted" message instead of hanging.

# Points deducted when a submission arrived after the deadline (default 10).
# Set to 0 to switch the late penalty off; late work is then graded normally.
# Leave the line out entirely and 10 is used. The value is clamped to 0-100 and
# anything unparseable falls back to 10, so a typo can never disable the rule
# or stop the app from starting.
LATE_PENALTY_POINTS=10

# --- Streamlit Community Cloud -------------------------------------------
# On Streamlit Community Cloud add these under Settings -> Secrets instead of
# using a .env file. Every value above can be set there too, under the same
# name; the app checks the environment first and falls back to Streamlit
# secrets, so a local .env always wins on your machine.
#
# GOOGLE_CREDENTIALS  full contents of credentials.json (OAuth Desktop client)
# GOOGLE_TOKEN        full contents of token.json (authorized user token)
#
# GOOGLE_TOKEN is required: a hosted server cannot open a browser to complete
# the OAuth consent flow, so mint token.json locally first:
#   python src/auth.py
# then paste its contents into the GOOGLE_TOKEN secret. Tokens expire; if
# grading starts failing with a 401, re-run that command and update the secret.
