# Portal configuration. Copy to portal/.env for local use and NEVER commit it.
# All variables are optional; the defaults boot a development server.

PORTAL_ENV=development
# PORTAL_DATABASE_URL=sqlite:///C:/absolute/path/to/portal/data/portal.db
# Leave PORTAL_SECRET_KEY unset in development: a random key is generated once
# in portal/data/secret_key. In production set a long random value explicitly.
# PORTAL_SECRET_KEY=replace-with-a-long-random-secret
PORTAL_HTTPS_ONLY=false
PORTAL_TIMEZONE=Asia/Jerusalem
PORTAL_APP_NAME=פורטל הכיתה
# PORTAL_SESSION_MAX_AGE=1209600
